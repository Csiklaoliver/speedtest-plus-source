{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedtest.example.invalid/schemas/ota-manifest.schema.json",
  "title": "Speedtest+ Android update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "versionCode",
    "versionName",
    "packageName",
    "apkUrl",
    "sha256",
    "sizeBytes",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "const": "stable" },
    "versionCode": { "type": "integer", "minimum": 1 },
    "versionName": { "type": "string", "minLength": 1, "maxLength": 32 },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "apkUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 209715200 },
    "notes": { "type": "string", "maxLength": 2000 }
  }
}

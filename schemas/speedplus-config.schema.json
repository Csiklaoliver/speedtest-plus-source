{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedtest.example.invalid/schemas/speedplus-config.schema.json",
  "title": "Speedtest+ optional configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "downloadMinMbps": { "type": ["number", "null"], "minimum": 0 },
    "downloadMaxMbps": { "type": ["number", "null"], "minimum": 0 },
    "uploadMinMbps": { "type": ["number", "null"], "minimum": 0 },
    "uploadMaxMbps": { "type": ["number", "null"], "minimum": 0 },
    "pingMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 9999 },
    "jitterMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 9999 },
    "packetLossPercent": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100,
      "multipleOf": 0.1
    },
    "isp": { "type": ["string", "null"], "maxLength": 64 },
    "serverProvider": { "type": ["string", "null"], "maxLength": 64 },
    "serverLocation": { "type": ["string", "null"], "maxLength": 64 }
  }
}
